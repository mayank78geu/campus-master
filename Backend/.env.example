# ==============================================================================
# Campus Master Backend - Environment Configuration Template
# Copy to .env or export in your environment.
# ==============================================================================

# Active Spring Profile (local, prod, test)
SPRING_PROFILES_ACTIVE=local

# MySQL Database Configuration
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/campusmaster?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_mysql_password_here

# JWT Secret - MUST be at least 256 bits (32 bytes) long.
# Generate with: openssl rand -base64 32
APP_JWT_SECRET=your_32_byte_base64_or_raw_jwt_secret_here

# Allowed CORS Origins (comma-separated)
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Storage Provider: 'local' (default for offline dev) or 'cloudinary'
CAMPUSMASTER_STORAGE_PROVIDER=local

# Cloudinary Configuration (required only when CAMPUSMASTER_STORAGE_PROVIDER=cloudinary)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
