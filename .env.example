# ==============================================================================
# Campus Master - Environment Configuration Template
# Copy this file to .env and supply actual deployment values.
# ==============================================================================

# Database Connection
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/campusmaster?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_mysql_password_here

# JWT Secret
# MUST be a cryptographically secure 256-bit (32 bytes) key in Base64 or raw string.
# Generate with: openssl rand -base64 32
# NOTE: Never commit secrets. Ensure any old compromised secrets are rotated immediately.
APP_JWT_SECRET=your_32_byte_base64_or_raw_jwt_secret_here

# Storage Provider Configuration ('local' or 'cloudinary')
CAMPUSMASTER_STORAGE_PROVIDER=local
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Frontend Configuration (for Frontend/.env)
# VITE_API_URL=http://localhost:8081/api/v1
